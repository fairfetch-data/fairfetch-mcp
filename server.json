{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.fairfetch-data/fairfetch-mcp",
  "title": "fairfetch: web data tools for AI agents, priced per result",
  "description": "Google Trends & Ads Transparency Center, keywords, apps, jobs, events, docs, screenshots, groceries",
